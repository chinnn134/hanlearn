# Backend Python/FastAPI configuration example. Copy to a local .env; never commit real values.
APP_ENV=local
FIREBASE_PROJECT_ID=your-firebase-project-id
# Keep 0 on synchronized hosts; bounded override exists for isolated local test VMs.
FIREBASE_TOKEN_CLOCK_SKEW_SECONDS=0
ALLOWED_ORIGINS=http://localhost:3000

# Optional OCR provider (Phase 09); leave unset during core phases.
OCR_SERVICE_URL=
OCR_SERVICE_API_KEY=
OCR_TIMEOUT_SECONDS=30
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_PIXELS=20000000

# Optional AI provider (Phase 10); leave unset during core phases.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUESTS_PER_MINUTE=2
AI_REQUESTS_PER_DAY=20

# Flutter needs only a public backend URL via --dart-define=API_BASE_URL.
# Never place OCR_SERVICE_API_KEY or AI_API_KEY in a Flutter define/build.
