rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('email' in data) || data.email == null
          || (data.email is string
            && data.email.size() <= 254
            && data.email == request.auth.token.email));
    }

    function validSavedWord(data, vocabId) {
      return data.keys().hasAll(['vocabId', 'savedAt', 'masteryLevel'])
        && data.keys().hasOnly(['vocabId', 'savedAt', 'masteryLevel'])
        && data.vocabId is string
        && data.vocabId == vocabId
        && data.vocabId.size() > 0
        && data.vocabId.size() <= 128
        && data.savedAt is timestamp
        && data.masteryLevel is int
        && data.masteryLevel == 0;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /vocabulary/{vocabId} {
      allow get, list: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{uid}/saved_words/{vocabId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid)
        && validSavedWord(request.resource.data, vocabId)
        && request.resource.data.savedAt == request.time;
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    // Unimplemented personal collections remain closed until their own phase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
